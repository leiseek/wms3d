{
  "name": "@wms3d/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure domain logic: geometry, location codes, classifyScan, planMovements",
  "exports": {
    ".": "./src/index.ts",
    "./geometry-golden.json": "./src/__fixtures__/geometry-golden.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:golden": "node --experimental-strip-types scripts/gen-golden.ts"
  },
  "dependencies": {
    "@wms3d/contracts": "workspace:*"
  }
}
