{
  "name": "@wms3d/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed API client + SSE + contract-driven mocks (MSW / Fastify)",
  "exports": {
    ".": "./src/index.ts",
    "./mock": "./src/mock/index.ts",
    "./mock-server": "./src/mock/server.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mock": "node --env-file-if-exists=../../.env.local --experimental-strip-types scripts/mock-server.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "~5.107.1",
    "@wms3d/contracts": "workspace:*",
    "@wms3d/domain": "workspace:*",
    "eventsource-parser": "4.1.3",
    "uuid": "~14.0.3",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@fastify/cors": "~11.4.1",
    "fastify": "~5.12.8",
    "msw": "~3.0.5"
  }
}
