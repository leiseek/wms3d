{
  "name": "wms3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:ownership": "node scripts/check-ownership.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:full": "bash scripts/ci-local.sh --full",
    "ci": "bash scripts/ci-local.sh",
    "e2e": "bash scripts/e2e.sh",
    "seed:demo": "bash scripts/seed-demo.sh",
    "backup:drill": "bash scripts/backup-drill.sh",
    "dev:api": "pnpm --filter @wms3d/api dev",
    "dev:admin": "pnpm --filter @wms3d/admin dev",
    "dev:mobile": "pnpm --filter @wms3d/mobile dev",
    "apk:debug": "bash scripts/build-apk.sh",
    "mock": "pnpm --filter @wms3d/api-client mock",
    "db:reset:dev": "bash scripts/db-reset-dev.sh",
    "gen:contracts": "pnpm --filter @wms3d/contracts gen:openapi && pnpm --filter @wms3d/domain gen:golden"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.65.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fast-check": "~4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.6.0",
    "tsx": "~4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
