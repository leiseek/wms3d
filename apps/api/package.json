{
  "name": "@wms3d/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env.local --experimental-strip-types src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node --env-file-if-exists=../../.env.local --experimental-strip-types src/db/migrate.ts",
    "db:migrate:url": "node --experimental-strip-types src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed:demo": "node --env-file-if-exists=../../.env.local --experimental-strip-types src/db/seed-demo.ts",
    "db:seed:stock": "node --env-file-if-exists=../../.env.local --experimental-strip-types src/modules/inventory/seed-stock.ts",
    "admin:create": "node --env-file-if-exists=../../.env.local --experimental-strip-types src/db/create-admin.ts",
    "db:reset:dev": "bash ../../scripts/db-reset-dev.sh"
  },
  "dependencies": {
    "@fastify/cookie": "~11.1.5",
    "@fastify/cors": "~11.4.1",
    "@fastify/multipart": "~10.1.8",
    "@fastify/rate-limit": "~11.2.2",
    "@fastify/swagger": "~9.9.3",
    "@fastify/swagger-ui": "~6.1.3",
    "@wms3d/contracts": "workspace:*",
    "@wms3d/domain": "workspace:*",
    "@wms3d/labels": "workspace:*",
    "argon2": "~0.45.2",
    "drizzle-orm": "~0.45.4",
    "fastify": "~5.12.8",
    "fastify-type-provider-zod": "~7.0.0",
    "jose": "~6.2.17",
    "node-cron": "~4.6.0",
    "pg": "~8.23.1",
    "uuid": "~14.0.3",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "~0.31.11"
  }
}
