# 复制为 .env（不要提交）。⚠️ compose 路径未在本机验证。
POSTGRES_PASSWORD=
WMS_OWNER_PASSWORD=
WMS_APP_PASSWORD=
# ≥ 32 字符：openssl rand -hex 32
JWT_SECRET=
WMS_DOMAIN=wms.example.com
# internal（内部 CA，设备需安装根证书）| 留空走 ACME（公网域名）
WMS_TLS=internal
TZ=Asia/Shanghai
# 异地备份（上线签字阻断项）：rclone 远端；需在 backup 容器内提供 rclone 与配置（见 infra/RUNBOOK.md）
BACKUP_REMOTE=
